{
  "name": "vista-web",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run generate:i18n && vite",
    "test:unit": "node --test src/client/*.test.ts src/state/*.test.ts src/composables/*.test.ts src/i18n/*.test.ts scripts/e2e-*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run generate:i18n && npm run check:i18n && vite build",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "generate:i18n": "node scripts/generate-chinese.ts && node scripts/generate-reply-languages.ts",
    "check:i18n": "node scripts/generate-chinese.ts --check && node scripts/generate-reply-languages.ts --check && node scripts/check-i18n.ts"
  },
  "dependencies": {
    "@ark-ui/vue": "5.40.0",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/vue": "3.8.0",
    "@tabler/icons-vue": "3.51.0",
    "@tanstack/charts": "1.5.0",
    "@tanstack/vue-query": "5.107.1",
    "@tanstack/vue-virtual": "3.13.52",
    "dompurify": "^3.4.16",
    "markdown-it": "^15.0.2",
    "medium-zoom": "1.1.0",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@intlify/devtools-types": "^11.4.12",
    "@intlify/message-compiler": "10.0.8",
    "@playwright/test": "1.62.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "opencc-js": "1.4.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
